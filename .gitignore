# Data (large; see DATA_SOURCES.md) - keep only .gitkeep placeholders
data/**
!data/**/
!data/**/.gitkeep

# Models and large outputs
models/*
!models/.gitkeep
results/**/*.parquet
results/**/*.npy
results/**/*.npz

# Large / binary artefacts
*.zip
*.csv.gz
*.gz
*.parquet
*.h5
*.hdf5
*.pkl
*.joblib
*.pt
*.pth
*.onnx
*.xlsx

# Python / notebooks / environments
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/

# Secrets
.env
.env.*

# OS files
.DS_Store
Thumbs.db
*:Zone.Identifier
